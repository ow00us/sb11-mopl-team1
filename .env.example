# 운영 환경 파일 예시입니다. 실제 값을 여기 적지 않습니다.
#
# 서버에서는 /etc/mopl/prod.env 로 두고 배포 계정만 읽을 수 있게 권한을 잠급니다.
#
#   sudo install -o deploy -g deploy -m 600 /dev/null /etc/mopl/prod.env
#   docker compose -f docker-compose.prod.yml --env-file /etc/mopl/prod.env up -d
#
# 각 값의 의미와 필수 여부는 DEPLOYMENT.md 의 "운영 환경 변수" 절에 있습니다.

# ── 배포 대상 ─────────────────────────────────────────────
# 외부 공개 도메인입니다. CORS, WebSocket origin, OAuth Callback URI 가 이 값에서 파생됩니다.
MOPL_DOMAIN=
# 영속 데이터를 둘 호스트 경로입니다.
MOPL_DATA_ROOT=/srv/mopl/data

# ── 이미지 ────────────────────────────────────────────────
# 레지스트리에서 받습니다. latest 가 아니라 commit SHA 태그나 digest 로 지정해야
# 되돌릴 대상을 지목할 수 있습니다.
BACKEND_IMAGE=
FRONTEND_IMAGE=
ELASTICSEARCH_IMAGE=
ELASTICSEARCH_JAVA_OPTS=-Xms512m -Xmx512m

# ── 컨테이너 메모리 한도 ──────────────────────────────────
# 백엔드 이미지가 -XX:MaxRAMPercentage 로 힙을 잡습니다. 한도가 없으면 JVM 이 호스트 전체
# 메모리를 기준으로 계산해, 인스턴스 둘이 합쳐 호스트보다 큰 힙을 요구합니다.
# 아래 합계는 약 7.3GB 로, 8GB 호스트에서 OS 몫을 남깁니다.
BACKEND_MEM_LIMIT=1536m
POSTGRES_MEM_LIMIT=1g
REDIS_MEM_LIMIT=512m
KAFKA_MEM_LIMIT=1g
ELASTICSEARCH_MEM_LIMIT=1536m

# ── PostgreSQL ───────────────────────────────────────────
POSTGRES_DB=mopl
POSTGRES_USER=mopl
POSTGRES_PASSWORD=

# ── 인증 ──────────────────────────────────────────────────
# Base64 로 디코딩한 길이가 32바이트 이상이어야 합니다.
JWT_SECRET=

# ── SMTP ──────────────────────────────────────────────────
# 값을 주지 않으면 기동이 실패합니다. 로컬 기본값인 localhost:1025 로 조용히 뜨지 않습니다.
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS_ENABLE=true

# ── OAuth Provider ───────────────────────────────────────
# Callback URI 는 Compose 가 MOPL_DOMAIN 에서 만듭니다. 각 Provider Console 에 등록한
# 값과 같아야 합니다.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
KAKAO_OAUTH_CLIENT_ID=
KAKAO_OAUTH_CLIENT_SECRET=
NAVER_OAUTH_CLIENT_ID=
NAVER_OAUTH_CLIENT_SECRET=

# ── 이미지 저장소 ─────────────────────────────────────────
# 자격 증명은 두지 않습니다. EC2 인스턴스 역할을 씁니다.
IMAGE_STORAGE_BUCKET=
IMAGE_STORAGE_PUBLIC_BASE_URL=
IMAGE_STORAGE_REGION=ap-northeast-2

# ── 외부 콘텐츠 API ──────────────────────────────────────
TMDB_ACCESS_TOKEN=
SPORTSDB_API_KEY=
